# SUCCESS Bank — backend environment template
# Copy to backend/.env and fill in real values for local dev.
# NEVER commit a real .env.

# --- App ---
APP_ENV=development            # development | staging | production
APP_NAME=SUCCESS Bank API
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Security ---
JWT_SECRET=change-me-please-use-a-32+-char-random-string
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
PASSWORD_PEPPER=optional-extra-secret-mixed-into-hashes

# --- Database ---
DATABASE_URL=postgresql+asyncpg://success:success_dev_pw@localhost:5432/success_bank

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (S3-compatible / MinIO) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=successadmin
S3_SECRET_KEY=successadmin_dev_pw
S3_BUCKET=success-attachments
S3_REGION=us-east-1

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:5173

# --- Email (SMTP — dev uses MailHog/console) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@successbank.local

# --- SLA defaults (minutes) — overridden by sla_policies table once seeded ---
SLA_CRITICAL_MINUTES=120
SLA_HIGH_MINUTES=360
SLA_MEDIUM_MINUTES=1440
SLA_LOW_MINUTES=4320

# --- AI (Ollama — local, free) ---
# LLM_PROVIDER: ollama (local) | anthropic (cloud) | none (disabled)
LLM_PROVIDER=ollama

# Ollama base URL — when running inside Docker use host.docker.internal
# When running the backend directly (no Docker) use http://localhost:11434
#
# IMPORTANT (macOS): Ollama binds to 127.0.0.1 by default, which the Docker VM
# cannot reach. Let it accept connections from containers with:
#     launchctl setenv OLLAMA_HOST 0.0.0.0
# then restart Ollama. Verify from inside the container with:
#     docker compose -f infra/docker-compose.yml exec backend \
#       curl -s http://host.docker.internal:11434/api/tags
# Or just call GET /api/v1/ai/health — it reports exactly what is wrong.
LLM_BASE_URL=http://host.docker.internal:11434

# Model name exactly as shown by `ollama list`
# GLM-4: glm4   |   Llama: llama3.2:3b   |   Qwen: qwen2.5:3b
LLM_MODEL=glm4

AI_ENABLED=true
AI_MAX_TOKENS=1024
AI_CONFIDENCE_THRESHOLD=0.7

# Local models are slow to produce a first token — a cold GLM-4 request on an
# M2 Mac can take 60s+. Keep this comfortably above your observed worst case.
AI_TIMEOUT_SECONDS=180
# How long Ollama keeps the model in memory after a request (avoids cold starts)
AI_KEEP_ALIVE=10m

# Anthropic (only needed when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=

# --- Email Ingestion (IMAP) ---
IMAP_ENABLED=false
IMAP_HOST=imap.successbank.local
IMAP_PORT=993
IMAP_USER=support@successbank.local
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_USE_SSL=true
SUPPORT_EMAIL=support@successbank.local

# --- Notifications ---
NOTIFICATION_EMAIL_ENABLED=true
MANAGER_EMAILS=manager@successbank.local
