# SUCCESS Bank — backend environment template
# Copy to backend/.env and fill in real values for local dev.
# NEVER commit a real .env.

# --- App ---
APP_ENV=development            # development | staging | production
APP_NAME=SUCCESS Bank API
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# --- Security ---
JWT_SECRET=change-me-please-use-a-32+-char-random-string
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
PASSWORD_PEPPER=optional-extra-secret-mixed-into-hashes

# --- Database ---
DATABASE_URL=postgresql+asyncpg://success:success_dev_pw@localhost:5432/success_bank

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (S3-compatible / MinIO) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=successadmin
S3_SECRET_KEY=successadmin_dev_pw
S3_BUCKET=success-attachments
S3_REGION=us-east-1

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:5173

# --- Email (SMTP — dev uses MailHog/console) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@successbank.local

# --- SLA defaults (minutes) — overridden by sla_policies table once seeded ---
SLA_CRITICAL_MINUTES=120
SLA_HIGH_MINUTES=360
SLA_MEDIUM_MINUTES=1440
SLA_LOW_MINUTES=4320

# --- AI ---
# Set AI_PROVIDER to 'groq' (default, free tier) or 'anthropic'.
# Whichever you choose, only that provider's API key needs to be set.
AI_PROVIDER=groq
AI_ENABLED=true
AI_MAX_TOKENS=1024
AI_CONFIDENCE_THRESHOLD=0.7

# Groq — get a free key at https://console.groq.com/keys
# Default model is Llama 3.3 70B; other good options:
#   llama-3.1-8b-instant         (cheapest, fastest, lower quality)
#   llama-3.3-70b-versatile      (default, recommended)
#   deepseek-r1-distill-llama-70b (reasoning tasks)
#   mixtral-8x7b-32768           (long-context legacy)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Anthropic — only needed if AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Email Ingestion (IMAP) ---
IMAP_ENABLED=false
IMAP_HOST=imap.successbank.local
IMAP_PORT=993
IMAP_USER=support@successbank.local
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX
IMAP_USE_SSL=true
SUPPORT_EMAIL=support@successbank.local

# --- Notifications ---
NOTIFICATION_EMAIL_ENABLED=true
MANAGER_EMAILS=manager@successbank.local
